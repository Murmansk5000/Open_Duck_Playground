<mujoco model="My Custom Terrain"> <!-- Model name -->
    <include file="open_duck_mini_v2.xml"/> <!-- Includes the robot -->
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
                 width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
                 rgb1="0.8 0.8 0.8" rgb2="0.7 0.7 0.7"
                 markrgb="0.6 0.6 0.6" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true"
                  texrepeat="10 10" reflectance="0.2"/>
        <material name="obstacle_mat" rgba="0.7 0.6 0.5 1"/> <!-- Obstacle material -->
    </asset>
    <worldbody>
        <!-- Ground (must be kept, name must be "floor") -->
        <body name="floor">
            <geom name="floor" size="20 20 0.01" type="plane"
                  material="groundplane" contype="1" conaffinity="0"
                  priority="1" friction="0.8" condim="3"/>
        </body>
        <!-- Add your obstacles here -->
        <!-- Example: a 2mm high obstacle strip -->
        <geom name="strip_001" type="box"
              size="0.005 1.5 0.001"
              pos="-1.0 0.0 0.001"
              material="obstacle_mat" friction="0.8"/>
        <!-- size="half_width_X half_length_Y half_height_Z" pos="pos_X pos_Y pos_Z" -->
        <!-- For 2mm height, half_height=0.001 and pos Z=0.001. -->
    </worldbody>
    <!-- Initial pose (copy from scene_flat_terrain.xml, do not change) -->
    <keyframe>
        <key name="home"
            qpos="
    0 0 0.15
    1 0 0 0
      0.002
        0.053
        -0.63
        1.368
        -0.784
        0
        0
        0
        0
        -0.003
        -0.065
        0.635
        1.379
        -0.796
"
            ctrl="
          0.002
        0.053
        -0.63
        1.368
        -0.784
        0
        0
        0
        0
        -0.003
        -0.065
        0.635
        1.379
        -0.796
          "/>
    </keyframe>
</mujoco>
